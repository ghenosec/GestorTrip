{
  "name": "gestortrip",
  "version": "1.0.2",
  "license_api_url": "https://gestortrip-licenses.gestortrip.workers.dev/activate",
  "private": true,
  "description": "Sistema de gestão de viagens",
  "author": "Ghenosec",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/post-build.js",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "next build && electron .",
    "electron:build": "next build && node scripts/post-build.js && electron-builder"
  },
  "build": {
    "appId": "com.ghenosec.gestortrip",
    "productName": "GestorTrip",
    "asar": true,
    "icon": "public/favicon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-3f0f13db5d6349cf8cb11c0581ebbfc3.r2.dev"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GestorTrip",
      "unicode": true
    },
    "npmRebuild": true
  },
  "dependencies": {
